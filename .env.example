# ============================================================
# Prompt Injectulator – environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Development / local testing mode
# Set to "true" ONLY for local development. NEVER in production.
# When true:
#   - A bootstrap admin/test account is created automatically.
#   - JWT_SECRET and ADMIN_EMAILS may be omitted (defaults are used).
#   - The mock LLM provider is available to the admin account.
# ------------------------------------------------------------
DEV_MODE=true

# Dev-mode test account credentials (only used when DEV_MODE=true)
DEV_TEST_EMAIL=admin@localhost
DEV_TEST_PASSWORD=changeme

# ------------------------------------------------------------
# Production settings (required when DEV_MODE is false/unset)
# ------------------------------------------------------------

# JWT signing secret – use a long random string (min 32 chars).
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of privileged admin email addresses.
# These users can access the mock provider and admin panel.
ADMIN_EMAILS=

# ------------------------------------------------------------
# LLM provider settings (only needed for real/paid API)
# ------------------------------------------------------------
OPENAI_API_KEY=

# Per-user token budget (default: 10000).
# Requests that would exceed this limit are rejected with HTTP 402.
USER_TOKEN_LIMIT=10000

# HTTP port (default: 8080)
PORT=8080
