# ============================================================
# Prompt Injectulator – environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# JWT signing secret – REQUIRED in ALL modes (dev and production).
# Must be at least 32 characters. Leave blank here; generate your own:
#   openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------
# Development / local testing mode
# Set to "true" ONLY for local development. NEVER in production.
# When true:
#   - A bootstrap admin/test account is created from DEV_TEST_EMAIL/PASSWORD.
#   - The mock LLM provider is available to the admin account.
# When false or unset:
#   - DEV_TEST_EMAIL and DEV_TEST_PASSWORD are ignored and must not be set.
#   - ADMIN_EMAILS is required.
# ------------------------------------------------------------
DEV_MODE=false

# Dev-mode test account credentials (required when DEV_MODE=true).
# You must choose your own values – no default is provided.
# Password must be at least 8 characters and must not be a common placeholder.
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=

# ------------------------------------------------------------
# Production settings (required when DEV_MODE is false/unset)
# ------------------------------------------------------------

# Comma-separated list of privileged admin email addresses.
# These users can access the mock provider and admin panel.
ADMIN_EMAILS=

# ------------------------------------------------------------
# LLM provider settings
# ------------------------------------------------------------

# Cloud (paid) providers are disabled by default.
# Set to "true" only when you have configured an API key and
# explicitly want to allow paid API calls.
CLOUD_API_ENABLED=false

# OpenAI API key – only used when CLOUD_API_ENABLED=true.
OPENAI_API_KEY=

# Per-user token budget (default: 10000).
# Requests that would exceed this limit are rejected with HTTP 402.
USER_TOKEN_LIMIT=10000

# ------------------------------------------------------------
# Server settings
# ------------------------------------------------------------

# HTTP port (default: 8080)
PORT=8080
